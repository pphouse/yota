# ---- 文章AI ----
# auto（既定）：キーが設定されているものを Anthropic → OpenAI → Gemini の順に使う。どれもなければダミー応答。
LLM_PROVIDER=auto

# Anthropic（Claude）
ANTHROPIC_API_KEY=
# 省略時は fast=claude-haiku-5-5、quality=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_QUALITY=

# OpenAI（互換APIなら OPENAI_BASE_URL も）
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_QUALITY=
OPENAI_BASE_URL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_QUALITY=

# ダミー応答の1文字あたりの待ち時間（ミリ秒）
MOCK_DELAY_MS=12

# ---- データベース ----
# 開発中はローカルファイル。本番は Turso など libSQL 互換のURLとトークン。
DATABASE_URL=file:data/yota.db
DATABASE_AUTH_TOKEN=

# ---- 安全設定 ----
MIN_AGE=13
MINOR_DAILY_LIMIT_SEC=10800

# 1分あたりの送信上限（セッションごと）
RATE_LIMIT_PER_MIN=20
